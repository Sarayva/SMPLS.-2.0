rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sugestões de categoria compartilhadas entre todos os usuários do app —
    // qualquer usuário logado pode ler e ensinar, ninguém vê dado pessoal
    // aqui (só "essa descrição de compra = essa categoria").
    match /categoriasGlobaisCompras/{chave} {
      allow read, write: if request.auth != null;
    }
  }
}
